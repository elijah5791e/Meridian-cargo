# Copy this file to .env for local development.
# On Render (or any host), set these as real environment variables instead —
# don't upload a .env file.

# Password required to access the Ship manager (/admin). Change this.
ADMIN_PASSWORD=changeme

# Used to sign session cookies. Any long random string works — mash your
# keyboard. If you don't set one, the server generates a temporary one on
# each restart, which logs everyone out on redeploy.
SESSION_SECRET=replace-with-a-long-random-string

# MongoDB connection string. Required for shipments to persist permanently —
# without this, data is stored in a local file that most hosts (including
# Render) wipe on every redeploy. See README.md for how to get a free one
# from MongoDB Atlas.
# Example: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/
MONGODB_URI=

# Port the server listens on. Render sets this automatically.
PORT=3000
