# Copy this file to .env for local development.
# Render (or any host) should set these as real environment variables instead.

# Password required to access the Ship manager tab. Change this.
ADMIN_PASSWORD=changeme

# Used to sign session cookies. Any long random string works.
# If you don't set one, the server generates a temporary one on each restart
# (which logs everyone out on redeploy) — set a fixed value for production.
SESSION_SECRET=replace-with-a-long-random-string

# Port the server listens on. Render sets this automatically — you usually
# don't need to set it yourself except for local development.
PORT=3000
